@startuml domain-settlement
title Payouts and settlement snapshots

top to bottom direction
hide empty members
hide circle
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam titleFontSize 22
skinparam ArrowColor #64748B
skinparam classBorderColor #64748B
skinparam classBackgroundColor #FFFFFF
skinparam classBackgroundColor<<AggregateRoot>> #DBEAFE
skinparam classBackgroundColor<<Snapshot>> #FFF7ED
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 40

class PayoutAttempt <<AggregateRoot>> {
  +payoutId : UUID
  +sessionId : UUID
  +payoutAccountId : UUID
  +amount : Money
  +status : PayoutStatus
  +idempotencyKey : string
  +requestedAt : Date
  +completedAt : Date [0..1]
  +failedAt : Date [0..1]
  +providerReference : string [0..1]
  +failureReason : string [0..1]
  --
  {static} +create(batch : PayoutBatch) : PayoutAttempt
  +complete(providerReference : string, at : Date) : boolean
  +fail(reason : string, at : Date) : boolean
  +requestedIntent() : PayoutRequestedIntent
}

interface PayoutBatch <<Snapshot>> {
  +payoutId : UUID
  +sessionId : UUID
  +idempotencyKey : string
  +requestedAt : Date
  +lines : PayoutLine [1..*]
  +destination : PayoutDestination
}

interface PayoutLine <<Snapshot>> {
  +holdId : UUID
  +participationId : UUID
  +holdingAccountId : UUID
  +walletId : UUID
  +amount : Money
  +kind : RELEASE | FORFEIT
}

interface PayoutDestination <<Snapshot>> {
  +payoutAccountId : UUID
  +userId : UUID
  +providerAccountReference : string
  +bankAccountReference : string
}

PayoutAttempt .right.> PayoutBatch : create(batch)
PayoutAttempt "1" *-down- "1..*" PayoutLine : fixed line copies
PayoutAttempt "1" *-down- "1" PayoutDestination : fixed destination copy
PayoutLine -[hidden]right- PayoutDestination

caption Selected public members. Booker prepares the batch; Session validates and owns its pending copy.\nPayoutAttempt retains its own copies; amount equals the sum of positive lines with unique hold IDs.\nCompleting an attempt alone changes no session holds or ledger entries; retries create a new attempt.\nIDs refer to Session, PayoutAccount, User, Participation, FundHold, Wallet and HoldingAccount.
@enduml
