<mxfile host="build_dialog_map.py"><diagram name="Dialog Map" id="lab3"><mxGraphModel dx="2560" dy="1200" grid="1" gridSize="10" guides="1" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="region-in" value="&lt;b&gt;Signed in (app shell)&lt;/b&gt;&lt;br&gt;nav(Home | Discover | My sessions | Wallet | Groups | Settings) reaches each top-level screen from any state in this region&lt;br&gt;any protected screen [signed out] / redirect(/login?next=screen)&lt;br&gt;addEmail()[no email] / open Email Address (shell prompt; an address is required, confirming it is not)" style="rounded=1;arcSize=1;dashed=1;fillColor=none;strokeColor=#888888;html=1;whiteSpace=wrap;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2080" y="150" width="1000" height="847" as="geometry"/></mxCell><mxCell id="Wallet" value="&lt;b&gt;Wallet&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/wallet&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / query available balance,&lt;br&gt;held funds &amp;amp; tx history&lt;br&gt;topUp(amount)[valid] / PayNow;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;webhook credits wallet&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2110" y="330" width="190" height="124" as="geometry"/></mxCell><mxCell id="Groups" value="&lt;b&gt;Groups&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/groups&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / list my groups&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2350" y="330" width="190" height="79" as="geometry"/></mxCell><mxCell id="GroupDetails" value="&lt;b&gt;Group Details&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/groups/{id}&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / list members &amp;amp;&lt;br&gt;invitation link&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2350" y="540" width="190" height="94" as="geometry"/></mxCell><mxCell id="JoinGroup" value="&lt;b&gt;Join Group&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/groups/join/{token}&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2350" y="740" width="190" height="64" as="geometry"/></mxCell><mxCell id="Settings" value="&lt;b&gt;Settings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/profile&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / load preferences &amp;amp;&lt;br&gt;reliability score&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2600" y="330" width="190" height="94" as="geometry"/></mxCell><mxCell id="EditProfile" value="&lt;b&gt;Edit Profile&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/profile/edit&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2600" y="540" width="190" height="64" as="geometry"/></mxCell><mxCell id="DeleteAccount" va