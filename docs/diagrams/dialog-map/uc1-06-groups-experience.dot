digraph GroupsExperience {
  graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="0.85", label="UC1-06 · Groups experience", labelloc=t, fontsize=22, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#c8d0da", fontcolor="#17202b", fontname="Helvetica", fontsize=12, margin="0.18,0.14"];
  edge [color="#718096", fontcolor="#465466", fontname="Helvetica", fontsize=10, arrowsize=0.7];
  groups [label="Your groups\n/groups\nAll · Owned · Joined · Archived"];
  details [label="Create group · Details\n/groups/new\nName · Save session draft"];
  players [label="Create group · Invite players\nFind exact user IDs · Add / remove\nUp to 20 players"];
  create [shape=diamond, label="Create group\nthen send invitations", fillcolor="#e8eef6"];
  partial [label="Group created\nIdentify failed invitations\nOpen existing group", fillcolor="#fff3dc"];
  members [label="Group details · Members\n/groups/{id}\nMember history · Invitation sidebar"];
  invites [label="Group details · Invitations\nShare link / invite by user ID\nPlayers invited by ID accept to join"];
  archived [label="Archived group\nMembers / history only\nNo sharing or mutation controls"];
  groups -> details [label="Create group"];
  details -> groups [label="Cancel"];
  details -> players [label="Continue [valid name]"];
  players -> details [label="Back [lookup settled]"];
  players -> create [label="Create [lookup settled]"];
  create -> players [label="Creation refused / retain fields"];
  create -> partial [label="Any invitation failed"];
  create -> members [label="All invitations sent"];
  partial -> members [label="Open group"];
  groups -> members [label="Open active group"];
  members -> groups [label="All groups / leave [member]"];
  members -> invites [label="Invitations tab"];
  invites -> members [label="Members tab / options link"];
  members -> archived [label="Archive [owner confirms]"];
  invites -> archived [label="Archive [owner confirms]\nrestore Members tab"];
  groups -> archived [label="Open archived group"];
}
