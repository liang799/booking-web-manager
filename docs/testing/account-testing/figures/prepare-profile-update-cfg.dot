digraph G {
  graph [rankdir=LR, bgcolor="white", margin="0.08", pad="0.08", nodesep="0.18", ranksep="0.30", fontname="Arial", fontsize=12];
  node [shape=box, style="rounded,filled", fillcolor="#f0f0f0", color="#555555", fontcolor="black", fontname="Arial", fontsize=10.5, penwidth=1.0, margin="0.07,0.05"];
  edge [color="#333333", fontcolor="black", fontname="Arial", fontsize=9, arrowsize=0.6, penwidth=1.0];
  P0 [shape=oval, label="P0\nEntry"];
  P1 [shape=diamond, label="P1\nAccount\nactive?"];
  P2 [shape=diamond, label="P2\nTrimmed name\nnot empty?"];
  P3 [shape=diamond, label="P3\nName at most\n60 chars?"];
  P4 [shape=diamond, label="P4\nNo blank\nsport?"];
  P5 [shape=diamond, label="P5\nNo blank\nregion?"];
  P6 [shape=diamond, label="P6\nAt least\none sport?"];
  P7 [shape=diamond, label="P7\nEvery sport\nsupported?"];
  P8 [shape=diamond, label="P8\nAt least\none region?"];
  P9 [shape=diamond, label="P9\nEvery region\nsupported?"];
  P10 [shape=box, label="P10\nReturn trimmed,\ndeduplicated changes"];
  P11 [shape=box, label="P11\nThrow\nINACTIVE_ACCOUNT"];
  P12 [shape=box, label="P12\nThrow\nINVALID_INPUT"];
  P13 [shape=oval, label="P13\nExit"];
  P0 -> P1;
  P1 -> P11 [label="F"];
  P1 -> P2 [label="T"];
  P2 -> P12 [label="F"];
  P2 -> P3 [label="T"];
  P3 -> P12 [label="F"];
  P3 -> P4 [label="T"];
  P4 -> P12 [label="F"];
  P4 -> P5 [label="T"];
  P5 -> P12 [label="F"];
  P5 -> P6 [label="T"];
  P6 -> P12 [label="F"];
  P6 -> P7 [label="T"];
  P7 -> P12 [label="F"];
  P7 -> P8 [label="T"];
  P8 -> P12 [label="F"];
  P8 -> P9 [label="T"];
  P9 -> P12 [label="F"];
  P9 -> P10 [label="T"];
  P10 -> P13;
  P11 -> P13;
  P12 -> P13;
}
