digraph G {
  graph [rankdir=LR, bgcolor="white", margin="0.08", pad="0.08", nodesep="0.18", ranksep="0.30", fontname="Arial", fontsize=12];
  node [shape=box, style="rounded,filled", fillcolor="#f0f0f0", color="#555555", fontcolor="black", fontname="Arial", fontsize=10.5, penwidth=1.0, margin="0.07,0.05"];
  edge [color="#333333", fontcolor="black", fontname="Arial", fontsize=9, arrowsize=0.6, penwidth=1.0];
  G0 [shape=oval, label="G0\nEntry"];
  G1 [shape=diamond, label="G1\nFields\nvalid?"];
  G2 [shape=box, label="G2\nReturn\nfix fields"];
  G3 [shape=diamond, label="G3\nConfirmation\nlink ready?"];
  G4 [shape=box, label="G4\nReturn\nlink error"];
  G5 [shape=box, label="G5\nSign up with\nSupabase"];
  G6 [shape=diamond, label="G6\nError: user\nalready exists?"];
  G7 [shape=diamond, label="G7\nHidden\nduplicate?"];
  G8 [shape=box, label="G8\nReturn\nemail taken"];
  G9 [shape=diamond, label="G9\nOther\nerror?"];
  G10 [shape=box, label="G10\nReturn\ncouldn't create"];
  G11 [shape=diamond, label="G11\nNo session\nyet?"];
  G12 [shape=box, label="G12\nReturn\ncheck email"];
  G13 [shape=box, label="G13\nRedirect to\ndestination"];
  G14 [shape=oval, label="G14\nExit"];
  G0 -> G1;
  G1 -> G2 [label="F"];
  G1 -> G3 [label="T"];
  G2 -> G14;
  G3 -> G4 [label="F"];
  G3 -> G5 [label="T"];
  G4 -> G14;
  G5 -> G6;
  G6 -> G8 [label="T"];
  G6 -> G7 [label="F"];
  G7 -> G8 [label="T"];
  G7 -> G9 [label="F"];
  G8 -> G14;
  G9 -> G10 [label="T"];
  G9 -> G11 [label="F"];
  G10 -> G14;
  G11 -> G12 [label="T"];
  G11 -> G13 [label="F"];
  G12 -> G14;
  G13 -> G14;
}
