digraph G {
  graph [rankdir=LR, bgcolor="white", margin="0.08", pad="0.08", nodesep="0.18", ranksep="0.30", size="8.8,3.45", dpi=220, fontname="Arial", fontsize=12];
  node [shape=box, style="rounded,filled", fillcolor="#f0f0f0", color="#555555", fontcolor="black", fontname="Arial", fontsize=10.5, penwidth=1.0, margin="0.07,0.05"];
  edge [color="#333333", fontcolor="black", fontname="Arial", fontsize=9, arrowsize=0.6, penwidth=1.0];
  B0 [shape=oval, label="B0\nEntry"];
  B1 [shape=diamond, label="B1\nStatus\nREMOVED?"];
  B2 [shape=diamond, label="B2\nStatus\nCANCELLED?"];
  B3 [shape=diamond, label="B3\nHold\npresent?"];
  B4 [shape=diamond, label="B4\nHold not\nterminal?"];
  B5 [shape=box, label="B5\nKeep participation\nNo refund"];
  B6 [shape=box, label="B6\nRefund + cancel\nOne REFUND"];
  B7 [shape=box, label="B7\nCancel\nNo refund"];
  B8 [shape=oval, label="B8\nExit"];
  B0 -> B1;
  B1 -> B5 [label="T"];
  B1 -> B2 [label="F"];
  B2 -> B5 [label="T"];
  B2 -> B3 [label="F"];
  B3 -> B4 [label="T"];
  B3 -> B7 [label="F"];
  B4 -> B6 [label="T"];
  B4 -> B7 [label="F"];
  B5 -> B8;
  B6 -> B8;
  B7 -> B8;
}
