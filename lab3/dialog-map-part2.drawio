<mxfile host="build_dialog_map.py"><diagram name="Dialog Map" id="lab3"><mxGraphModel dx="2560" dy="1200" grid="1" gridSize="10" guides="1" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="region-in" value="&lt;b&gt;Signed in (app shell)&lt;/b&gt;&lt;br&gt;nav(Home | Discover | My sessions | Wallet | Groups | Settings) reaches each top-level screen from any state in this region&lt;br&gt;any protected screen [signed out] / redirect(/login?next=screen)" style="rounded=1;arcSize=1;dashed=1;fillColor=none;strokeColor=#888888;html=1;whiteSpace=wrap;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="150" width="1010" height="1029" as="geometry"/></mxCell><mxCell id="MySessions" value="&lt;b&gt;My Sessions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/sessions&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / list hosted sessions with server-selected actions&lt;br&gt;toggleVisibility(Public | Private)[open, not full] / refresh&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1100" y="330" width="610" height="94" as="geometry"/></mxCell><mxCell id="Participants" value="&lt;b&gt;Manage Participants&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/sessions/{id}/participants&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / list roster &amp;amp; waitlist&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1100" y="620" width="190" height="79" as="geometry"/></mxCell><mxCell id="RemoveDialog" value="&lt;b&gt;Remove Participant&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;dialog&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / GET removal-preview:&lt;br&gt;display wallet refund&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1100" y="830" width="190" height="94" as="geometry"/></mxCell><mxCell id="CancelDialog" value="&lt;b&gt;Cancel Session&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;dialog&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / GET cancellation-preview:&lt;br&gt;display total wallet refunds&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1310" y="620" width="190" height="94" as="geometry"/></mxCell><mxCell id="Verify" value="&lt;b&gt;Verify Attendance&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;planned · POST /api/sessions/attendance&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / list committed participants&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1520" y="620" width="190" height="79" as="geometry"/></mxCell><mxCell id="CreateVenue" value="&lt;b&gt;Create Session: Venue Details&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/sessions/create · step 1&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;do / search venues (OneMap)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1860" y="330" width="190" height="79" as="geometry"/></mxCell><mxCell id="CreateSettings" value="&lt;b&gt;Create Session: Settings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;step 2&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;schedule, slots, visibility,&lt;br&gt;minimum reliability&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1860" y="520" width="190" height="94" as="geometry"/></mxCell><mxCell id="CreateShare" value="&lt;b&gt;Create Session: Booking Share&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;step 3&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / compute booking share&lt;br&gt;server-side&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1860" y="710" width="190" height="94" as="geometry"/></mxCell><mxCell id="Email" value="&lt;b&gt;Email Verification&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#666666'&gt;/profile/email&lt;/font&gt;&lt;hr style='border:none;border-top:1px solid #000;margin:4px 0'&gt;&lt;div style='text-align:left;font-size:10px'&gt;entry / show verification status&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1860" y="900" width="190" height="79" as="geometry"/></mxCell><mxCell id="fromHome" value="&lt;i&gt;Home&lt;/i&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;see Part 1&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#888888;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1880" y="180" width="150" height="44" as="geometry"/></mxCell><mxCell id="fromJoin" value="&lt;i&gt;Join Confirmation&lt;/i&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;see Part 1&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#888888;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1560" y="1020" width="150" height="44" as="geometry"/></mxCell><mxCell id="fromSettings2" value="&lt;i&gt;Settings&lt;/i&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;see Part 3&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#888888;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1880" y="1060" width="150" height="44" as="geometry"/></mxCell><mxCell id="e100" value="Create a session" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fromHome" target="CreateVenue"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e101" value="Confirm()[email unverified]" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;entryX=0;entryY=0.7;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="fromJoin" target="Email"><mxGeometry x="0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e102" value="Create a session" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="MySessions" target="CreateVenue"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e103" value="Next()[valid]" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.4;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="CreateVenue" target="CreateSettings"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e104" value="Back" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.6;exitY=0;entryX=0.6;entryY=1;" edge="1" parent="1" source="CreateSettings" target="CreateVenue"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e105" value="Next()[valid]" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.4;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="CreateSettings" target="CreateShare"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e106" value="Back" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.6;exitY=0;entryX=0.6;entryY=1;" edge="1" parent="1" source="CreateShare" target="CreateSettings"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e107" value="Confirm()[email verified]&lt;br&gt;/computeShare + genLink" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;exitX=0;exitY=0.4;entryX=1;entryY=0.75;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="CreateShare" target="MySessions"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1785" y="755"/><mxPoint x="1785" y="420"/></Array></mxGeometry></mxCell><mxCell id="e108" value="Confirm()[email unverified]" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="CreateShare" target="Email"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e109" value="Manage participants" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.1;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="MySessions" target="Participants"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e110" value="Back" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.7;exitY=0;entryX=0.22;entryY=1;" edge="1" parent="1" source="Participants" target="MySessions"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e111" value="Remove(participant)" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="Participants" target="RemoveDialog"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e112" value="Confirm() / refund + notify&lt;br&gt;Cancel" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="RemoveDialog" target="Participants"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e113" value="Cancel session&lt;br&gt;[before start]" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.44;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="MySessions" target="CancelDialog"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e114" value="Confirm() / refundAll&lt;br&gt;Cancel" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.7;exitY=0;entryX=0.56;entryY=1;" edge="1" parent="1" source="CancelDialog" target="MySessions"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e115" value="Verify attendance&lt;br&gt;[ended]" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;dashPattern=6 4;exitX=0.78;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="MySessions" target="Verify"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e116" value="Submit(marks) / markPayable&lt;br&gt;Back" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;dashPattern=6 4;exitX=0.7;exitY=0;entryX=0.9;entryY=1;" edge="1" parent="1" source="Verify" target="MySessions"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e117" value="Email" style="html=1;rounded=1;endArrow=open;endSize=8;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="fromSettings2" target="Email"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="Format: event(arguments)[guard]/action  |  solid dot = start  |  bullseye = end  |  divider separates state name from entry/do actions and internal transitions  |  &lt;b&gt;dashed = planned screen&lt;/b&gt; (API on main, UI not yet built)  |  grey box = screen drawn in another part" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1070" y="1189" width="1010" height="36" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Dialog Map (Lab 3) Part 2: hosting and creating a session&lt;/b&gt;" style="text;html=1;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="1070" y="100" width="1010" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>